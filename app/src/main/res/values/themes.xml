<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The whole UI is Jetpack Compose; this is only the window theme
         Android uses before Compose takes over (splash flash, status bar). -->
    <style name="Theme.RootAppKiller" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#121212</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">#121212</item>
        <item name="android:navigationBarColor">#121212</item>
    </style>
</resources>
