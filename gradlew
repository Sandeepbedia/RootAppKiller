#!/bin/sh
# Generated by PhoneIDE.
#
# Shared storage is noexec, so run this as:  sh gradlew assembleDebug
# (./gradlew reports "Permission denied" no matter what chmod says.)

APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 1
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$WRAPPER_JAR" ]; then
    # No wrapper jar. The Gradle installed by PhoneIDE matches the version in
    # gradle-wrapper.properties, so use it rather than failing on a missing
    # class. Run `gradle wrapper` once if you want a real wrapper jar.
    if command -v gradle >/dev/null 2>&1; then
        exec gradle "$@"
    fi
    echo "gradlew: no gradle-wrapper.jar and no 'gradle' on PATH." >&2
    echo "gradlew: install Gradle from Toolchains, or run: gradle wrapper" >&2
    exit 1
fi

if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
elif command -v java >/dev/null 2>&1; then
    JAVACMD=java
else
    echo "gradlew: no JAVA_HOME and no 'java' on PATH." >&2
    exit 1
fi

exec "$JAVACMD" -Xmx64m -Xms64m -classpath "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
